# Eligible — environment.
#
# Copy this file to .env and fill in your own values. .env is gitignored and
# must never be committed, pasted into a message, or screenshotted.
#
# You can run the whole product with NOTHING filled in: without credentials the
# server reads the local fixtures and every screen says "local fixtures" on it.
# Fill these in only when you want the Appwrite path.

# --- required for Appwrite mode -------------------------------------------
# The endpoint contains the region. A wrong region returns
# 401 "Project is not accessible in this region", which looks like a bad key.
# Must match your project's region: fra, nyc, sgp, syd, tor, bom.
# Example for a Frankfurt project:
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=

# Server API key. For a demo, scope it to rows.read + rows.write and revoke it
# after the hackathon. It never reaches the browser bundle.
APPWRITE_API_KEY=

# --- ids, with the defaults setup-appwrite.ts creates ----------------------
APPWRITE_DATABASE_ID=eligible
APPWRITE_TABLE_SCHEMES=schemes
APPWRITE_TABLE_PROFILES=profiles
APPWRITE_TABLE_SEARCHES=searches

# --- the meaning layer ----------------------------------------------------
# VectorsDB needs dedicated compute (Micro, ~$10/month) because its index lives
# in RAM. Fill these in only after that is provisioned: with the collection
# absent the app does not crash, it ranks by lexical overlap and says so.
VECTORS_DATABASE_ID=eligible_vectors
VECTORS_COLLECTION_ID=scheme_text
EMBEDDING_MODEL=nomic-embed-text-v1.5

# --- optional -------------------------------------------------------------
# Port for the API, and for the built site it serves. Default 4317.
PORT=4317

# An OpenAI-compatible endpoint lets the free-text box be parsed by a model
# instead of the built-in rule parser. Absent is fine: the app never needs it,
# and the rules engine still decides eligibility either way.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
