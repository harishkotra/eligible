{
  "name": "eligible",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Describe your life in one sentence and find the Indian government schemes you actually qualify for. Runs on Appwrite TablesDB for the rules and VectorsDB for the meaning.",
  "license": "MIT",
  "scripts": {
    "fixtures": "tsx scripts/ingest.ts",
    "dev": "vite",
    "api": "tsx watch server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx scripts/test-engine.ts",
    "build": "tsc -b && vite build",
    "setup:appwrite": "tsx scripts/setup-appwrite.ts",
    "verify:appwrite": "tsx scripts/verify-appwrite.ts",
    "e2e": "node scripts/e2e.mjs",
    "audit": "node scripts/audit-ui.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "node-appwrite": "^31.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
